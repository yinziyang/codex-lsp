{
  "name": "codex-lsp",
  "version": "0.2.0",
  "description": "官方 Plugin、共享 LSP 核心与 Pi/Codex 适配器。",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "src",
    "extensions",
    "plugins",
    "dist",
    "README.md",
    "VALIDATION.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\" \"tests/*.test.ts\"",
    "test:real": "node --test tests/product-real.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:install": "node scripts/plugin-lifecycle.mjs",
    "build": "node scripts/build.mjs",
    "format": "prettier --write src scripts tests",
    "test:portable": "node --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "ignore": "7.0.8",
    "vscode-jsonrpc": "^9.0.2",
    "vscode-languageserver-protocol": "^3.18.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./src/pi.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^24.13.6",
    "esbuild": "0.25.10",
    "prettier": "3.6.2",
    "smol-toml": "1.4.2",
    "typebox": "^1.3.27",
    "typescript": "5.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yinziyang/codex-lsp.git"
  },
  "homepage": "https://github.com/yinziyang/codex-lsp",
  "bugs": {
    "url": "https://github.com/yinziyang/codex-lsp/issues"
  }
}
